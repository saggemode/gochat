<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="60dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSolidColor"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="23dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/whatsapp_emerald"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/viewSolidColor"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/ivSolidSelected"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_pulse"
                android:backgroundTint="@color/whatsapp_emerald"
                android:padding="4dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvSolidName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/gochat_text_secondary"
        android:textSize="10sp"
        tools:text="Teal" />

</LinearLayout>
