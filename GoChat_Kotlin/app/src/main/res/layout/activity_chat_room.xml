<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_wallpaper_dark">

    <!-- Background custom photo/image wallpaper -->
    <ImageView
        android:id="@+id/ivCustomWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Custom Chat Wallpaper"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Subtle WhatsApp Doodle Pattern Layer -->
    <com.example.gochat.ui.chat.ChatDoodleView
        android:id="@+id/chatDoodleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/chatContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Custom Action Bar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarChatRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/whatsapp_toolbar_dark"
            app:contentInsetStart="4dp"
            app:contentInsetEnd="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_back" />

                <!-- Contact Avatar with Online Dot -->
                <FrameLayout
                    android:id="@+id/layoutAvatarHeader"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="2dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivHeaderAvatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="Avatar"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_account"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                    <View
                        android:id="@+id/viewHeaderOnlineDot"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_online_indicator"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- Name & Status Subtitle -->
                <LinearLayout
                    android:id="@+id/layoutHeaderInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvChatTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/gochat_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Alex Smith" />

                        <ImageView
                            android:id="@+id/ivToolbarVerified"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Verified Store"
                            android:src="@drawable/ic_verified_badge"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <ImageView
                            android:id="@+id/ivHeaderDisappearingBadge"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="5dp"
                            android:contentDescription="Disappearing Messages Active"
                            android:src="@drawable/ic_timer"
                            android:visibility="gone"
                            app:tint="@color/gochat_emerald_light"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvChatSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/gochat_emerald_light"
                        android:textSize="11.5sp"
                        tools:text="online" />
                </LinearLayout>

                <!-- BBM PING! Action Button -->
                <ImageView
                    android:id="@+id/btnPing"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="PING!"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_ping_bell" />

                <!-- Call Action Button -->
                <ImageView
                    android:id="@+id/btnCall"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Call"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_tab_calls" />

                <!-- More Options Menu -->
                <ImageView
                    android:id="@+id/btnMoreChatOptions"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="More"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- In-Chat Search Bar Overlay -->
        <LinearLayout
            android:id="@+id/layoutInChatSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/whatsapp_toolbar_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btnCloseSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Close search"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                app:tint="@color/gochat_text_secondary" />

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search in chat..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="@color/gochat_text_primary"
                android:textColorHint="@color/gochat_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSearchMatchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:textColor="@color/gochat_text_secondary"
                android:textSize="12sp"
                tools:text="1 of 5" />

            <ImageView
                android:id="@+id/btnSearchPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Previous result"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/gochat_text_secondary" />

            <ImageView
                android:id="@+id/btnSearchNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Next result"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/gochat_text_secondary" />
        </LinearLayout>

        <!-- Linked Order Sticky Header Banner -->
        <LinearLayout
            android:id="@+id/layoutLinkedOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2500A884"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_orders"
                app:tint="@color/gochat_emerald_light"
                android:contentDescription="Order" />

            <TextView
                android:id="@+id/tvLinkedOrderText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/gochat_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Linked Order: #ORD-849201 • $1,199.00" />

            <TextView
                android:id="@+id/btnViewLinkedOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/whatsapp_teal_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Track"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseLinkedOrder"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dismiss"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                app:tint="@color/gochat_text_secondary" />
        </LinearLayout>

        <!-- Pinned Message Sticky Header Bar -->
        <LinearLayout
            android:id="@+id/layoutPinnedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E2A30"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_pinned"
                app:tint="@color/whatsapp_teal_light"
                android:contentDescription="Pinned Message" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPinnedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/whatsapp_teal_light"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Pinned Message" />

                <TextView
                    android:id="@+id/tvPinnedSnippet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="12.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Bank transfer details: Account # 1234-5678-90" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnUnpinMessage"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Unpin"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                app:tint="@color/gochat_text_secondary" />
        </LinearLayout>

        <!-- Message List Container with Floating FAB Overlay -->
        <FrameLayout
            android:id="@+id/layoutMessageListContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="8dp"
                tools:listitem="@layout/item_message_me" />

            <!-- Floating Unread Messages Pill & Scroll-to-Bottom FAB -->
            <LinearLayout
                android:id="@+id/layoutScrollToBottomContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                android:elevation="6dp"
                tools:visibility="visible">

                <!-- Floating Unread Messages Pill -->
                <LinearLayout
                    android:id="@+id/layoutUnreadBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/gochat_accent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvUnreadMessagesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↓ 1 new message"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Scroll-to-Bottom Circular FAB -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnScrollToBottomFab"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/gochat_surface_dark"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/gochat_border_dark"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_down"
                        android:contentDescription="Scroll to bottom"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </FrameLayout>

        <!-- Bot Moderation Banner -->
        <TextView
            android:id="@+id/tvBotBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A34D399"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:text="@string/bot_moderation_active"
            android:textColor="@color/gochat_emerald_light"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Quoted Reply Preview Bar (above input bar) -->
        <LinearLayout
            android:id="@+id/layoutReplyPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_reply_preview_bar"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/gochat_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReplyPreviewSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_emerald_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Replying to Alex" />

                <TextView
                    android:id="@+id/tvReplyPreviewText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="12sp"
                    tools:text="I will send the document over in a bit." />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseReplyPreview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Cancel reply"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Editing Preview Bar -->
        <LinearLayout
            android:id="@+id/layoutEditPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_reply_preview_bar"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/gochat_emerald_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_emerald_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/edit_message_label" />

                <TextView
                    android:id="@+id/tvEditPreviewText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="12sp"
                    tools:text="Original message snippet..." />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseEditPreview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Cancel edit"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Mentions Suggestions -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMentionSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_card_dark"
            android:elevation="4dp"
            android:visibility="gone"
            tools:listitem="@layout/item_group_member"
            tools:visibility="visible" />

        <!-- Slide-to-Lock Floating Pill -->
        <LinearLayout
            android:id="@+id/layoutSlideToLock"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_card_dark"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivLockIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/slide_to_lock"
                android:src="@drawable/ic_lock"
                app:tint="@color/gochat_emerald_light" />

            <ImageView
                android:id="@+id/ivArrowUp"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/slide_to_lock"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/gochat_text_muted" />
        </LinearLayout>

        <!-- Chat Input Bar -->
        <LinearLayout
            android:id="@+id/layoutNormalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <!-- Rounded Input Capsule -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <!-- Attachment Button -->
                <ImageView
                    android:id="@+id/btnAttachment"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Attach"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_attach_file" />

                <!-- Text Input -->
                <EditText
                    android:id="@+id/etMessageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/message_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/gochat_text_primary"
                    android:textColorHint="@color/gochat_text_muted"
                    android:textSize="15.5sp" />

                <!-- AI Tone Assistant Button -->
                <ImageView
                    android:id="@+id/btnToneAssistant"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="AI Tone Assistant"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_sparkle"
                    android:visibility="gone"
                    app:tint="@color/gochat_emerald_light"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Send / Voice Button -->
            <FrameLayout
                android:id="@+id/btnSendOrVoice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_emerald"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true">

                <!-- Send Icon (when text entered) -->
                <ImageView
                    android:id="@+id/ivSendIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Send"
                    android:src="@drawable/ic_send"
                    android:visibility="gone"
                    app:tint="@color/black"
                    tools:visibility="visible" />

                <!-- Mic Icon (when empty) -->
                <ImageView
                    android:id="@+id/ivMicIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Voice note"
                    android:src="@drawable/ic_mic"
                    android:visibility="visible"
                    app:tint="@color/black" />
            </FrameLayout>

        </LinearLayout>

        <!-- Voice Note Recording Bar Overlay -->
        <LinearLayout
            android:id="@+id/layoutVoiceRecording"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Discard / Trash Button -->
            <ImageView
                android:id="@+id/btnCancelVoiceRecording"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Discard"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_delete_recording"
                app:tint="#FF3B30" />

            <!-- Live Status Container: Red Pulsing Dot + Live Timer -->
            <LinearLayout
                android:id="@+id/layoutRecordingLiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewRecordingDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_circle_pulse"
                    android:backgroundTint="#FF3B30" />

                <TextView
                    android:id="@+id/tvRecordingTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="00:05" />
            </LinearLayout>

            <!-- Preview Status Container: Play/Pause Button + Preview Timer -->
            <LinearLayout
                android:id="@+id/layoutRecordingPreviewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/btnPlayPreview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_button_emerald"
                    android:clickable="true"
                    android:contentDescription="Play preview"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/tvPreviewTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="00:03 / 00:08" />
            </LinearLayout>

            <!-- Slide To Cancel Hint (visible during hold-to-record sliding) -->
            <TextView
                android:id="@+id/tvSlideToCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/slide_to_cancel"
                android:textColor="@color/gochat_text_muted"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Waveform Visualizer -->
            <com.example.gochat.ui.custom.WaveformView
                android:id="@+id/waveformRecording"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <!-- Pause Recording Button (during active locked recording) -->
            <ImageView
                android:id="@+id/btnPauseRecording"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/action_pause_recording"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_pause"
                android:visibility="visible"
                app:tint="#FF3B30"
                tools:visibility="visible" />

            <!-- Resume Recording Button (when paused) -->
            <ImageView
                android:id="@+id/btnResumeRecording"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/action_resume_recording"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_mic"
                android:visibility="gone"
                app:tint="#FF3B30"
                tools:visibility="visible" />

            <!-- Send Voice Note Button -->
            <ImageView
                android:id="@+id/btnSendVoiceRecording"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_emerald"
                android:clickable="true"
                android:contentDescription="Send Voice Note"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_send"
                android:visibility="visible"
                app:tint="@color/black"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
