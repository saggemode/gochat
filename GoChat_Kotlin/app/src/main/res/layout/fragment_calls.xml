<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gochat_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top AppBar -->
        <LinearLayout
            android:id="@+id/layoutCallsHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/gochat_surface_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calls_title"
                android:textColor="@color/gochat_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSearchCalls"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="@color/gochat_text_primary" />

            <ImageButton
                android:id="@+id/btnClearCallLog"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear call log"
                android:padding="9dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/gochat_text_secondary" />

        </LinearLayout>

        <!-- Search Overlay (Collapsible) -->
        <LinearLayout
            android:id="@+id/layoutSearchCalls"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/gochat_surface_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/gochat_text_secondary" />

            <EditText
                android:id="@+id/etSearchCalls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_calls_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/gochat_text_primary"
                android:textColorHint="@color/gochat_text_secondary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close search"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/gochat_text_secondary" />
        </LinearLayout>

        <!-- Filter Chips (All vs Missed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gochat_surface_dark"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/chipAllCalls"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/filter_all"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipMissedCalls"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/filter_missed"
                android:textColor="@color/gochat_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshCalls"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="80dp">

                    <!-- Create Call Link Tile -->
                    <LinearLayout
                        android:id="@+id/tileCreateCallLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_button_emerald">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="Link Icon"
                                android:src="@drawable/ic_link"
                                app:tint="@color/black" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_call_link"
                                android:textColor="@color/gochat_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/create_call_link_desc"
                                android:textColor="@color/gochat_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Section: Recent -->
                    <TextView
                        android:id="@+id/tvRecentLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/recent_header"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Calls RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCalls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_call_record" />

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyCalls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:alpha="0.4"
                            android:contentDescription="Calls Placeholder"
                            android:src="@drawable/ic_tab_calls"
                            app:tint="@color/gochat_text_secondary" />

                        <TextView
                            android:id="@+id/tvEmptyCallsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/no_calls_yet"
                            android:textColor="@color/gochat_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptyCallsDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/no_calls_desc"
                            android:textColor="@color/gochat_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- Floating Action Button: New Call -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="New Call"
        android:src="@drawable/ic_add_call"
        app:backgroundTint="@color/gochat_accent"
        app:elevation="6dp"
        app:fabSize="normal"
        app:tint="@color/black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
