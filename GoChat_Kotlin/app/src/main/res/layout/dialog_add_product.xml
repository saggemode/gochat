<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/gochat_border_dark" />

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="List New Product"
            android:textColor="@color/gochat_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Add your item to GoChat Marketplace &amp; your Storefront"
            android:textColor="@color/gochat_text_muted"
            android:textSize="13sp" />

        <!-- Product Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Product Title *"
            android:textColorHint="@color/gochat_text_muted"
            app:boxStrokeColor="@color/whatsapp_teal_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gochat_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Price and Original Price Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Selling Price ($) *"
                android:textColorHint="@color/gochat_text_muted"
                app:boxStrokeColor="@color/whatsapp_teal_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/gochat_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Original Price ($)"
                android:textColorHint="@color/gochat_text_muted"
                app:boxStrokeColor="@color/whatsapp_teal_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductOriginalPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/gochat_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Category and Stock Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Category (e.g. Phones)"
                android:textColorHint="@color/gochat_text_muted"
                app:boxStrokeColor="@color/whatsapp_teal_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Electronics"
                    android:textColor="@color/gochat_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Stock Units *"
                android:textColorHint="@color/gochat_text_muted"
                app:boxStrokeColor="@color/whatsapp_teal_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProductStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="10"
                    android:textColor="@color/gochat_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Product Images Picker (Max 3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Product Photos (Max 3) *"
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhotosCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/3 selected"
                    android:textColor="@color/whatsapp_teal_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horizontal container for photo pickers and previews -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutPhotoThumbnailsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Add Photo Card Button -->
                    <LinearLayout
                        android:id="@+id/layoutAddPhoto"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_photo_add_slot"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_camera_status"
                            app:tint="@color/whatsapp_teal_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+ Add"
                            android:textColor="@color/whatsapp_teal_light"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Preview Frame 1 -->
                    <FrameLayout
                        android:id="@+id/framePreview1"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPreview1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                        <ImageButton
                            android:id="@+id/btnRemovePhoto1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_circle_close_badge"
                            android:contentDescription="Remove photo"
                            android:padding="4dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <!-- Preview Frame 2 -->
                    <FrameLayout
                        android:id="@+id/framePreview2"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPreview2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                        <ImageButton
                            android:id="@+id/btnRemovePhoto2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_circle_close_badge"
                            android:contentDescription="Remove photo"
                            android:padding="4dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <!-- Preview Frame 3 -->
                    <FrameLayout
                        android:id="@+id/framePreview3"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPreview3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                        <ImageButton
                            android:id="@+id/btnRemovePhoto3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_circle_close_badge"
                            android:contentDescription="Remove photo"
                            android:padding="4dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/white" />
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tap '+ Add' to select up to 3 pictures from your phone."
                android:textColor="@color/gochat_text_muted"
                android:textSize="12sp" />

            <!-- Upload progress indicator -->
            <LinearLayout
                android:id="@+id/layoutUploadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/whatsapp_teal_light" />

                <TextView
                    android:id="@+id/tvUploadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Uploading photos..."
                    android:textColor="@color/whatsapp_teal_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Item Description"
            android:textColorHint="@color/gochat_text_muted"
            app:boxStrokeColor="@color/whatsapp_teal_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProductDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:lines="3"
                android:textColor="@color/gochat_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitProduct"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/whatsapp_teal_light"
            android:text="Publish Product"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
