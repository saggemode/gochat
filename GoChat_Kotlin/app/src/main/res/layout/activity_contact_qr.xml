<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contactQrRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gochat_surface_dark">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarContactQr"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gochat_surface_dark"
        app:navigationIcon="@drawable/ic_back"
        app:title="My QR code"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarContactQr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvQrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#111B21"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="My Name" />

            <TextView
                android:id="@+id/tvQrPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#667781"
                android:textSize="14sp"
                tools:text="PIN: ABC123" />

            <ImageView
                android:id="@+id/ivQr"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="20dp"
                android:contentDescription="My QR code" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Your contact QR code. Anyone can scan it with GoChat to add you and start a chat."
                android:textColor="#667781"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanContactQr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="28dp"
        android:paddingVertical="14dp"
        android:text="Scan a contact's code"
        android:textSize="16sp"
        app:icon="@drawable/ic_qr_code"
        app:iconGravity="textStart"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/cardQr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareMyQr"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="12dp"
        android:paddingVertical="14dp"
        android:text="Share my code"
        android:textSize="16sp"
        app:icon="@drawable/ic_forward"
        app:iconGravity="textStart"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/btnScanContactQr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
