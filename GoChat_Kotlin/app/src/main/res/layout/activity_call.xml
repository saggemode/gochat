<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121B22">

    <!-- Remote Video -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Local Video (Picture-in-Picture) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localVideoView"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="4dp" />

    <!-- Call Info Overlay -->
    <LinearLayout
        android:id="@+id/layoutCallInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCallerAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_account"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Alex Smith" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/gochat_text_secondary"
            android:textSize="16sp"
            tools:text="Calling..." />
    </LinearLayout>

    <!-- Controls Overlay -->
    <LinearLayout
        android:id="@+id/layoutCallControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp">

        <!-- Speaker -->
        <LinearLayout
            android:id="@+id/containerSpeaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Speaker"
                android:src="@drawable/ic_volume_up"
                app:backgroundTint="#1F2C33"
                app:fabCustomSize="52dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Speaker"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Video -->
        <LinearLayout
            android:id="@+id/containerVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnToggleVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Video"
                android:src="@drawable/ic_videocam"
                app:backgroundTint="#1F2C33"
                app:fabCustomSize="52dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Video"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mute -->
        <LinearLayout
            android:id="@+id/containerMute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Mute"
                android:src="@drawable/ic_mic"
                app:backgroundTint="#1F2C33"
                app:fabCustomSize="52dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Mute"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- End / Decline -->
        <LinearLayout
            android:id="@+id/containerEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnEndCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="End call"
                android:src="@drawable/ic_call_end"
                app:backgroundTint="#F44336"
                app:fabCustomSize="52dp"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvEndLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="End"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- More -->
        <LinearLayout
            android:id="@+id/containerMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="More options"
                android:src="@drawable/ic_more_vert"
                app:backgroundTint="#1F2C33"
                app:fabCustomSize="52dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="More"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Accept (incoming calls only) -->
        <LinearLayout
            android:id="@+id/containerAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnAnswerCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Accept call"
                android:src="@drawable/ic_call"
                app:backgroundTint="#4CAF50"
                app:fabCustomSize="52dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Accept"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
