<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Close -->
    <ImageView
        android:id="@+id/btnCloseCamera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Close camera"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        app:tint="@color/white" />

    <!-- Recording timer -->
    <TextView
        android:id="@+id/tvRecTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#CCF44336"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="● 00:00"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Hint -->
    <TextView
        android:id="@+id/tvCameraHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="150dp"
        android:background="#55000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="Tap for photo, hold for video"
        android:textColor="#DDFFFFFF"
        android:textSize="13sp" />

    <!-- Shutter (tap = photo, hold = video) -->
    <FrameLayout
        android:id="@+id/btnShutter"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_camera_shutter_ring">

        <View
            android:id="@+id/viewShutterInner"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_camera_shutter_inner" />
    </FrameLayout>

    <!-- Flip camera -->
    <ImageView
        android:id="@+id/btnFlipCamera"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="52dp"
        android:background="@drawable/bg_circle_pulse"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Flip camera"
        android:padding="12dp"
        android:src="@drawable/ic_flip_camera"
        app:tint="@color/white" />

</FrameLayout>
