<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip_unselected"
            android:backgroundTint="@color/gochat_input_bg" />

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExportTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_chat_dialog_title"
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExportSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="13sp"
                    tools:text="Export conversation with Alex" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseExportSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/gochat_text_secondary" />
        </RelativeLayout>

        <!-- Information disclaimer banner -->
        <LinearLayout
            android:id="@+id/layoutDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#1F2C34"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Info"
                android:src="@drawable/ic_export_chat"
                app:tint="@color/gochat_emerald_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/export_chat_dialog_desc"
                android:textColor="@color/gochat_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Main Options Container -->
        <LinearLayout
            android:id="@+id/layoutExportOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Option 1: Without Media -->
            <LinearLayout
                android:id="@+id/btnOptionWithoutMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_pulse"
                    android:backgroundTint="#1A00A884">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Without Media"
                        android:src="@drawable/ic_attach_file"
                        app:tint="@color/gochat_emerald_light" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export_without_media"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/export_without_media_desc"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Arrow"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/gochat_text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="58dp"
                android:background="@color/border_subtle" />

            <!-- Option 2: Include Media -->
            <LinearLayout
                android:id="@+id/btnOptionIncludeMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_pulse"
                    android:backgroundTint="#1A3B82F6">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Include Media"
                        android:src="@drawable/ic_archive"
                        app:tint="#60A5FA" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export_include_media"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/export_include_media_desc"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Arrow"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/gochat_text_muted" />
            </LinearLayout>

            <!-- Option 3: Export Selected Messages (hidden if already selecting) -->
            <View
                android:id="@+id/dividerSelectedOption"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="58dp"
                android:background="@color/border_subtle" />

            <LinearLayout
                android:id="@+id/btnOptionSelectedMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_pulse"
                    android:backgroundTint="#1AF59E0B">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Selected Messages"
                        android:src="@drawable/ic_check"
                        app:tint="#FBBF24" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export_selected_messages"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/export_selected_messages_desc"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Arrow"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/gochat_text_muted" />
            </LinearLayout>

        </LinearLayout>

        <!-- Live Progress View (visible during export packaging) -->
        <LinearLayout
            android:id="@+id/layoutExportProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/progressBarExport"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginHorizontal="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="25"
                android:progressBackgroundTint="#2A3942"
                android:progressTint="@color/gochat_emerald_light" />

            <TextView
                android:id="@+id/tvExportProgressStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/gochat_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Gathering media (3 of 12)..." />

            <TextView
                android:id="@+id/tvExportPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gochat_emerald_light"
                android:textSize="12sp"
                tools:text="25%" />

            <Button
                android:id="@+id/btnCancelExport"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_cancel"
                android:textColor="@color/gochat_text_secondary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
