<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutTextStatusRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00A884">

    <!-- Top Bar with Close and Color Picker Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnCloseTextStatus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Change Background Color Button -->
        <ImageView
            android:id="@+id/btnChangeBgColor"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Color"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Centered Large Text Input -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="32dp">

        <EditText
            android:id="@+id/etStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:hint="@string/type_status_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="6"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Allow Reshare Toggle Pill -->
    <LinearLayout
        android:id="@+id/layoutReshareToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:background="@drawable/bg_view_count_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/ivReshareToggleIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Reshare Toggle"
            android:src="@drawable/ic_repeat"
            app:tint="@color/gochat_emerald_light" />

        <TextView
            android:id="@+id/tvReshareToggleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Reshare: Allowed"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Post Status FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPostStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:backgroundTint="@color/gochat_accent"
        android:contentDescription="Post Status"
        android:elevation="6dp"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_send"
        app:tint="@color/black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
