<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPollCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="260dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Type Badge (Poll/Quiz) & Expiration Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPollTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#2600A884"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/gochat_emerald_light"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="📊 POLL" />

        <TextView
            android:id="@+id/tvPollExpireTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#20E67E22"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="#F39C12"
            android:textSize="10.5sp"
            android:visibility="gone"
            tools:text="⏳ 2h left"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPollModeNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gochat_text_muted"
            android:textSize="11sp"
            tools:text="Select one" />
    </LinearLayout>

    <!-- Question -->
    <TextView
        android:id="@+id/tvPollQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/gochat_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Which programming language do you prefer for high-concurrency microservices?" />

    <!-- Options List Container -->
    <LinearLayout
        android:id="@+id/layoutPollOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Quiz Explanation Banner (Revealed after voting in Quiz mode) -->
    <LinearLayout
        android:id="@+id/layoutQuizExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_dark"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Explanation"
            android:textColor="@color/gochat_emerald_light"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuizExplanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gochat_text_secondary"
            android:textSize="12sp"
            tools:text="Go utilizes lightweight goroutines that cost only 2KB of stack space." />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#20FFFFFF" />

    <!-- Footer: Vote Count & Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPollTotalVotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gochat_text_muted"
            android:textSize="12sp"
            tools:text="👥 14 votes" />

        <!-- View Votes Action (Public Polls) -->
        <TextView
            android:id="@+id/btnViewPollVotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="View votes"
            android:textColor="@color/gochat_emerald_light"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
