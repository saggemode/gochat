<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Bottom sheet grab handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_unread_badge"
        android:backgroundTint="@color/gochat_border_dark" />

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Replies"
                android:textColor="@color/gochat_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Type / in chat or tap a response below"
                android:textColor="@color/gochat_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- New Template Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddNewTemplate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ New"
            android:textColor="@color/gochat_emerald_light"
            android:textSize="12sp"
            app:backgroundTint="@color/gochat_bg_dark"
            app:cornerRadius="18dp"
            app:strokeColor="@color/gochat_emerald_light"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Create New Quick Reply Inline Form (collapsible) -->
    <LinearLayout
        android:id="@+id/layoutCreateQuickReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_dark"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create New Quick Reply"
            android:textColor="@color/gochat_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNewShortcut"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:hint="Shortcut (e.g. /return)"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:paddingHorizontal="12dp"
            android:textColor="@color/gochat_text_primary"
            android:textColorHint="@color/gochat_text_muted"
            android:textSize="13.5sp" />

        <EditText
            android:id="@+id/etNewReplyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Full reply message..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:lines="3"
            android:maxLines="5"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/gochat_text_primary"
            android:textColorHint="@color/gochat_text_muted"
            android:textSize="13.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCreate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancel"
                android:textColor="@color/gochat_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveQuickReply"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="Save"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:backgroundTint="@color/gochat_emerald_light"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Replies RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuickReplies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:nestedScrollingEnabled="false"
        tools:itemCount="5"
        tools:listitem="@layout/item_quick_reply" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyQuickReplies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:gravity="center"
        android:text="No quick replies configured yet"
        android:textColor="@color/gochat_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
