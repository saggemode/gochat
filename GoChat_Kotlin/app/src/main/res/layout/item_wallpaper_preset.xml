<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPreset"
        android:layout_width="76dp"
        android:layout_height="100dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/whatsapp_emerald"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Gradient background swatch -->
            <View
                android:id="@+id/viewSwatchGradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Mini doodle preview -->
            <com.example.gochat.ui.chat.ChatDoodleView
                android:id="@+id/doodlePresetPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Selected checkmark badge -->
            <ImageView
                android:id="@+id/ivPresetSelected"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_pulse"
                android:backgroundTint="@color/whatsapp_emerald"
                android:padding="5dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvPresetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/gochat_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Emerald" />

</LinearLayout>
