<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gochat_surface_dark"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gochat_surface_dark"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="Order Tracking"
        app:titleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Order Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/gochat_surface_dark"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gochat_border_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOrderNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="Order #ORD-123456" />

                        <TextView
                            android:id="@+id/tvOrderStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="#00A884"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="OUT FOR DELIVERY" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOrderDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="12sp"
                        tools:text="Placed on Sep 19, 2026 14:00" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/gochat_border_dark" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStoreName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/gochat_emerald_light"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="iStore Official" />

                        <TextView
                            android:id="@+id/tvTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Total: $1,199.00" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChatWithParty"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/whatsapp_teal_light"
                        android:text="💬 Chat with Seller"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live Courier Tracking & Copy Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLiveTracking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#111B21"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/whatsapp_teal_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Courier Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Courier"
                            android:src="@drawable/ic_local_shipping"
                            app:tint="@color/whatsapp_teal_light" />

                        <TextView
                            android:id="@+id/tvCarrierName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="DHL Express Courier" />

                        <TextView
                            android:id="@+id/tvEstimatedDelivery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gochat_emerald_light"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Est: Today, 5 PM" />
                    </LinearLayout>

                    <!-- Tracking Number Row with Direct Copy Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TRACKING NUMBER"
                                android:textColor="@color/gochat_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTrackingNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="DHL-8492049182" />
                        </LinearLayout>

                        <!-- Direct Copy Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyTracking"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#1F2C34"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="Copy"
                            android:textAllCaps="false"
                            android:textColor="@color/whatsapp_teal_light"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_content_copy"
                            app:iconPadding="4dp"
                            app:iconSize="14dp"
                            app:iconTint="@color/whatsapp_teal_light" />
                    </LinearLayout>

                    <!-- Delivery Notes / Live Status description -->
                    <TextView
                        android:id="@+id/tvDeliveryNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="12sp"
                        tools:text="Courier rider is currently in transit to your delivery destination." />

                    <!-- Live Track Link Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrackPackage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:text="Track on Courier Website"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_link"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/gochat_border_dark"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Visual Horizontal Step Timeline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="Delivery Timeline"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/gochat_surface_dark"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gochat_border_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="20dp">

                    <!-- Horizontal Stepper Row: Icons & Progress Lines -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Step 1 Indicator: Paid -->
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/dotStep1"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_pill"
                                android:backgroundTint="#00A884" />

                            <ImageView
                                android:id="@+id/iconStep1"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="Done"
                                android:src="@drawable/ic_check"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Connecting Line 1 -> 2 -->
                        <View
                            android:id="@+id/lineStep1to2"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:background="#00A884" />

                        <!-- Step 2 Indicator: Shipped -->
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/dotStep2"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_pill"
                                android:backgroundTint="#00A884" />

                            <ImageView
                                android:id="@+id/iconStep2"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="Shipped"
                                android:src="@drawable/ic_check"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Connecting Line 2 -> 3 -->
                        <View
                            android:id="@+id/lineStep2to3"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:background="#00A884" />

                        <!-- Step 3 Indicator: Out for Delivery -->
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/dotStep3"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_pill"
                                android:backgroundTint="#00A884" />

                            <ImageView
                                android:id="@+id/iconStep3"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="Out for Delivery"
                                android:src="@drawable/ic_local_shipping"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <!-- Connecting Line 3 -> 4 -->
                        <View
                            android:id="@+id/lineStep3to4"
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_weight="1"
                            android:background="#374151" />

                        <!-- Step 4 Indicator: Delivered -->
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">

                            <View
                                android:id="@+id/dotStep4"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_pill"
                                android:backgroundTint="#374151" />

                            <ImageView
                                android:id="@+id/iconStep4"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="Delivered"
                                android:src="@drawable/ic_check"
                                app:tint="#6B7280" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Horizontal Stepper Row: Labels & Captions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Label Step 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep1Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Payment\nConfirmed"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStep1Time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textColor="@color/gochat_text_muted"
                                android:textSize="9sp"
                                tools:text="Sep 19" />
                        </LinearLayout>

                        <!-- Label Step 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep2Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Shipped\nby Seller"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStep2Time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textColor="@color/gochat_text_muted"
                                android:textSize="9sp"
                                tools:text="Sep 20" />
                        </LinearLayout>

                        <!-- Label Step 3 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep3Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Out for\nDelivery"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStep3Time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textColor="@color/gochat_text_muted"
                                android:textSize="9sp"
                                tools:text="Sep 21" />
                        </LinearLayout>

                        <!-- Label Step 4 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStep4Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Package\nDelivered"
                                android:textColor="@color/gochat_text_muted"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStep4Time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textColor="@color/gochat_text_muted"
                                android:textSize="9sp"
                                tools:text="Pending" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed Status History Events Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="Activity &amp; Courier Scans"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/gochat_surface_dark"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gochat_border_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/layoutHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvHistoryEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No tracking scans recorded yet."
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/layoutHistoryList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shipping Address Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="Destination &amp; Contact"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/gochat_surface_dark"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gochat_border_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Address"
                            android:src="@drawable/ic_location"
                            app:tint="@color/whatsapp_teal_light" />

                        <TextView
                            android:id="@+id/tvRecipientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Jane Doe" />

                        <TextView
                            android:id="@+id/tvRecipientPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/gochat_text_muted"
                            android:textSize="13sp"
                            tools:text="+234 801 234 5678" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvShippingAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="13sp"
                        tools:text="123 GoChat St, Victoria Island, Lagos, Nigeria" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
