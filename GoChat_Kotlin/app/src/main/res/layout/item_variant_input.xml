<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Size -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Size"
        android:textColorHint="@color/gochat_text_muted"
        app:boxStrokeColor="@color/whatsapp_teal_light">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVariantSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="12sp"
            android:textColor="@color/gochat_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Color -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:hint="Color"
        android:textColorHint="@color/gochat_text_muted"
        app:boxStrokeColor="@color/whatsapp_teal_light">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVariantColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="12sp"
            android:textColor="@color/gochat_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Stock -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:hint="Stock"
        android:textColorHint="@color/gochat_text_muted"
        app:boxStrokeColor="@color/whatsapp_teal_light">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVariantStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="12sp"
            android:textColor="@color/gochat_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <ImageButton
        android:id="@+id/btnRemoveVariant"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove variant"
        android:src="@drawable/ic_delete"
        app:tint="@color/gochat_text_muted" />

</LinearLayout>
