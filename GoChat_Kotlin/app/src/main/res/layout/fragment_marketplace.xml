<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gochat_bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whatsapp_toolbar_dark"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="16dp">

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/marketplace_title"
                android:textColor="@color/gochat_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Orders Icon -->
                <ImageView
                    android:id="@+id/btnOrders"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Orders"
                    android:padding="8dp"
                    android:src="@drawable/ic_orders"
                    app:tint="@color/gochat_text_primary" />

                <!-- Cart Icon with Badge -->
                <FrameLayout
                    android:id="@+id/btnCartContainer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btnCart"
                        android:layout_width=" match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Shopping Cart"
                        android:padding="10dp"
                        android:src="@drawable/ic_cart"
                        app:tint="@color/gochat_text_primary" />

                    <TextView
                        android:id="@+id/tvCartBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_discount_badge"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="2"
                        tools:visibility="visible" />
                </FrameLayout>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Main Marketplace Tabs: Explore vs Store -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutMain"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/whatsapp_toolbar_dark"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/whatsapp_teal_light"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/whatsapp_teal_light"
            app:tabTextColor="@color/gochat_text_muted">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_cart"
                android:text="Marketplace" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_storefront"
                android:text="My Store" />
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TAB 1: MARKETPLACE EXPLORE FEED                            -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutExploreTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Search Bar Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="@color/gochat_surface_dark"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gochat_border_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/gochat_text_muted" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_marketplace_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/gochat_text_primary"
                        android:textColorHint="@color/gochat_text_muted"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/gochat_text_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filters & Category Chips Horizontal Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVerifiedOnly"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/verified_only"
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/gochat_surface_dark"
                    app:chipStrokeColor="@color/gochat_border_dark"
                    app:chipStrokeWidth="1dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_category" />
            </LinearLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProducts"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:padding="6dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/item_product" />

                    <!-- Empty Explore State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyExplore"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_cart"
                            app:tint="@color/gochat_text_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="No products found"
                            android:textColor="@color/gochat_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Try adjusting your search terms or selecting another category."
                            android:textColor="@color/gochat_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TAB 2: SELLER HUB & STORE MANAGEMENT                       -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutStoreTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- STATE A: NO STORE YET (Store Creation Wizard) -->
                <LinearLayout
                    android:id="@+id/layoutNoStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/gochat_surface_dark"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/whatsapp_teal_light"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:src="@drawable/ic_storefront"
                                    app:tint="@color/whatsapp_teal_light" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Open Your Store on GoChat"
                                        android:textColor="@color/gochat_text_primary"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Start selling to millions of verified contacts"
                                        android:textColor="@color/gochat_text_muted"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Store Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:hint="Store / Business Name *"
                        android:textColorHint="@color/gochat_text_muted"
                        app:boxStrokeColor="@color/whatsapp_teal_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStoreName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gochat_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Category & Phone Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="Category"
                            android:textColorHint="@color/gochat_text_muted"
                            app:boxStrokeColor="@color/whatsapp_teal_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStoreCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Electronics"
                                android:textColor="@color/gochat_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="Phone Number"
                            android:textColorHint="@color/gochat_text_muted"
                            app:boxStrokeColor="@color/whatsapp_teal_light">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStorePhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:textColor="@color/gochat_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Location / Address -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:hint="Store Location / Address *"
                        android:textColorHint="@color/gochat_text_muted"
                        app:boxStrokeColor="@color/whatsapp_teal_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStoreLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lagos, Nigeria"
                            android:textColor="@color/gochat_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Store Logo Picker (From Phone) -->
                    <LinearLayout
                        android:id="@+id/layoutSelectStoreLogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_store_logo_picker"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivStoreLogoPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_photo_add_slot"
                                android:padding="14dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_camera_status"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
                                app:tint="@color/whatsapp_teal_light" />

                            <ImageButton
                                android:id="@+id/btnRemoveStoreLogo"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_circle_close_badge"
                                android:contentDescription="Remove logo"
                                android:padding="3dp"
                                android:src="@drawable/ic_close"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStoreLogoTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Store Logo"
                                android:textColor="@color/gochat_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStoreLogoSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Tap to select logo from phone"
                                android:textColor="@color/gochat_text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/gochat_text_muted" />
                    </LinearLayout>

                    <!-- Store Description -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:hint="Store Bio / Description"
                        android:textColorHint="@color/gochat_text_muted"
                        app:boxStrokeColor="@color/whatsapp_teal_light">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStoreDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lines="3"
                            android:textColor="@color/gochat_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateStore"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:backgroundTint="@color/whatsapp_teal_light"
                        android:text="@string/btn_create_store"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <!-- STATE B: SELLER HUB DASHBOARD (When user has store) -->
                <LinearLayout
                    android:id="@+id/layoutHasStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="visible">

                    <!-- Store Header Banner -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="@color/gochat_surface_dark"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/whatsapp_teal_light"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivHubStoreLogo"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_storefront"
                                app:shapeAppearanceOverlay="@style/CircleImage" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvHubStoreName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textColor="@color/gochat_text_primary"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        tools:text="iStore Official" />

                                    <ImageView
                                        android:layout_width="15dp"
                                        android:layout_height="15dp"
                                        android:layout_marginStart="4dp"
                                        android:src="@drawable/ic_verified_badge" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvHubStoreCategory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/whatsapp_teal_light"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="Electronics • PIN: 1P0YE4WZ" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnShareStore"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Share Store"
                                android:padding="8dp"
                                android:src="@drawable/ic_share"
                                app:tint="@color/whatsapp_teal_light" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Business Metrics Grid (4 Cards) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.08"
                        android:text="BUSINESS METRICS"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alignmentMode="alignMargins"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:useDefaultMargins="true">

                        <!-- Gross Revenue -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            app:cardBackgroundColor="@color/gochat_surface_dark"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/gochat_border_dark"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/gross_revenue"
                                    android:textColor="@color/gochat_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricRevenue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/whatsapp_teal_light"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    tools:text="$2,499.00" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Store Orders -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            app:cardBackgroundColor="@color/gochat_surface_dark"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/gochat_border_dark"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/store_orders"
                                    android:textColor="@color/gochat_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricOrders"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="#FBBF24"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    tools:text="14" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Listed Products -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            app:cardBackgroundColor="@color/gochat_surface_dark"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/gochat_border_dark"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/listed_products"
                                    android:textColor="@color/gochat_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricProducts"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/gochat_text_primary"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    tools:text="6" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Store Views -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_columnWeight="1"
                            app:cardBackgroundColor="@color/gochat_surface_dark"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/gochat_border_dark"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/store_views"
                                    android:textColor="@color/gochat_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricViews"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="#C084FC"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    tools:text="182" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </GridLayout>

                    <!-- Inventory Header Row with + Add Product Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvInventoryTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.08"
                            android:text="STORE INVENTORY"
                            android:textColor="@color/gochat_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddProduct"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:backgroundTint="@color/whatsapp_teal_light"
                            android:paddingHorizontal="14dp"
                            android:text="@string/btn_add_product"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- Store Inventory RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStoreProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_store_product" />

                    <!-- Empty Inventory Message -->
                    <TextView
                        android:id="@+id/tvEmptyStoreProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="No products in your store yet.\nTap '+ Add Product' to list your first item!"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>

    <!-- Global Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/whatsapp_teal_light"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
