<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvMomentAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gochat_emerald_light"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Alex Smith" />

    <TextView
        android:id="@+id/tvMomentContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        tools:text="Beautiful day at the beach! 🏖️" />

    <TextView
        android:id="@+id/tvMomentComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#14000000"
        android:padding="8dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Jane: Nice!" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMomentLike"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="♡ 12" />

        <TextView
            android:id="@+id/btnMomentComment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="💬 3" />
    </LinearLayout>
</LinearLayout>
