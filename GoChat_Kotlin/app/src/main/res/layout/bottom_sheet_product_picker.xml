<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Top Handle bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_unread_badge"
        android:backgroundTint="@color/gochat_border_dark" />

    <!-- Header title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_cart"
            app:tint="@color/whatsapp_teal_light"
            android:contentDescription="Marketplace" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Share a Product"
            android:textColor="@color/gochat_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnClosePicker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/gochat_text_secondary" />
    </LinearLayout>

    <!-- Search box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="@color/gochat_surface_dark"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/gochat_border_dark"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/gochat_text_muted" />

            <EditText
                android:id="@+id/etSearchProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search products to share..."
                android:textColorHint="@color/gochat_text_muted"
                android:textColor="@color/gochat_text_primary"
                android:textSize="13sp"
                android:maxLines="1"
                android:inputType="text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progressBarPicker"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp"
        android:indeterminateTint="@color/whatsapp_teal_light"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyProducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="32dp"
        android:text="No marketplace products found."
        android:textColor="@color/gochat_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Products list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProductsPicker"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        tools:listitem="@layout/item_product_picker" />

</LinearLayout>
