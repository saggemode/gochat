<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gochat_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gochat_surface_dark"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/gochat_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile Tile -->
        <LinearLayout
            android:id="@+id/tileProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <FrameLayout
                android:id="@+id/layoutAvatarContainer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/ivSettingsAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Profile photo"
                    android:src="@drawable/ic_account" />

                <!-- Uploading Scrim & Progress Bar -->
                <FrameLayout
                    android:id="@+id/layoutAvatarLoading"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_pulse"
                    android:backgroundTint="#99000000"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/pbAvatarLoading"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/white" />
                </FrameLayout>

                <!-- Camera badge at bottom-end -->
                <FrameLayout
                    android:id="@+id/ivCameraBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_pulse"
                    android:backgroundTint="@color/gochat_emerald_primary">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:contentDescription="Change photo"
                        android:src="@drawable/ic_camera_status"
                        app:tint="@color/white" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSettingsUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Alex Morgan" />

                    <ImageView
                        android:id="@+id/ivVerifiedBadge"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Verified"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/gochat_accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSettingsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="13sp"
                    tools:text="Building microservices in Go &amp; Kotlin" />

                <TextView
                    android:id="@+id/tvSettingsUserPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/gochat_emerald_light"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="GoChat PIN: 7A9F02B1" />

                <TextView
                    android:id="@+id/tvSettingsPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gochat_text_muted"
                    android:textSize="12sp"
                    tools:text="+1 (555) 019-2834" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnEditProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:contentDescription="Edit profile"
                android:src="@drawable/ic_edit_status"
                app:tint="@color/gochat_accent" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gochat_border_dark" />

        <!-- Menu items container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Chat Backup & Restore Row -->
            <LinearLayout
                android:id="@+id/tileChatBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Chat Backup"
                    android:src="@drawable/ic_cloud_backup"
                    app:tint="@color/gochat_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_backup_title"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBackupSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_backup_desc"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Open"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/gochat_text_muted" />
            </LinearLayout>

            <!-- Theme & Dark Mode Row -->
            <LinearLayout
                android:id="@+id/tileTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Theme"
                    android:src="@drawable/ic_theme_mode"
                    app:tint="@color/gochat_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_theme_title"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThemeSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_theme_default"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Open"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/gochat_text_muted" />
            </LinearLayout>

            <!-- Privacy Row -->
            <LinearLayout
                android:id="@+id/tilePrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Privacy"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/gochat_text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_privacy_title"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="15.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_privacy_desc"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notifications Row -->
            <LinearLayout
                android:id="@+id/tileNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_tab_calls"
                    app:tint="@color/gochat_text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notifications_title"
                        android:textColor="@color/gochat_text_primary"
                        android:textSize="15.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_notifications_desc"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Log Out Row -->
            <LinearLayout
                android:id="@+id/tileLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Log Out"
                    android:src="@drawable/ic_close"
                    app:tint="#FF3B30" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:text="@string/btn_logout"
                    android:textColor="#FF3B30"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
