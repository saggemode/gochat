<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="14dp"
        android:alpha="0.7"
        android:contentDescription="Message"
        android:src="@drawable/ic_chat_bubble_rounded"
        app:tint="@color/gochat_text_secondary"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gochat_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Jane Doe" />

        <TextView
            android:id="@+id/tvResultSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gochat_text_secondary"
            android:textSize="13sp"
            tools:text="…the meeting is at 3pm tomorrow…" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/gochat_text_secondary"
        android:textSize="11sp"
        tools:text="12:30 PM" />
</LinearLayout>
