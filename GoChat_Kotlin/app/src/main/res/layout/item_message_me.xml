<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="3dp">

    <!-- Outgoing Bubble Container -->
    <LinearLayout
        android:id="@+id/layoutBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:background="@drawable/bg_bubble_me"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">

        <!-- Forwarded Label -->
        <LinearLayout
            android:id="@+id/layoutForwarded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:alpha="0.6"
                android:src="@drawable/ic_forward"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:alpha="0.6"
                android:text="@string/label_forwarded"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Quoted Reply Container -->
        <include
            layout="@layout/layout_link_preview"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layoutQuotedReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_quoted_reply_me"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:background="@color/gochat_emerald_light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuotedSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_emerald_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Alex" />

                <TextView
                    android:id="@+id/tvQuotedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="12sp"
                    tools:text="Original message being replied to here..." />
            </LinearLayout>
        </LinearLayout>

        <!-- Media Image Preview -->
        <FrameLayout
            android:id="@+id/layoutImageContainer"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Attached Image"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <ProgressBar
                android:id="@+id/pbImageLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Voice Note Playback Row -->
        <LinearLayout
            android:id="@+id/layoutVoiceNote"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btnPlayPauseVoice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_pulse"
                android:contentDescription="Play/Pause"
                android:padding="8dp"
                android:src="@drawable/ic_play" />

            <com.example.gochat.ui.custom.WaveformView
                android:id="@+id/waveformVoice"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="11sp"
                    tools:text="0:14" />

                <TextView
                    android:id="@+id/btnVoiceSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_speed_pill"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="1.0x"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Product Card Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutProductCard"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#20FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#30FFFFFF"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProductCardImage"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                    android:contentDescription="Product Image"
                    tools:src="@drawable/ic_gallery" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvProductCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Product Name" />

                    <TextView
                        android:id="@+id/tvProductCardPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gochat_emerald_light"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        tools:text="$0.00" />

                    <TextView
                        android:id="@+id/btnViewProductCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="#30FFFFFF"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="View Product"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Message Text -->

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/gochat_text_primary"
            android:textSize="14.5sp"
            tools:text="Hey there! This is a test message in GoChat." />

        <!-- Reactions Container -->
        <LinearLayout
            android:id="@+id/layoutReactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_reactions"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="👍 2 ❤️ 1" />
        </LinearLayout>

        <!-- Footer: Timestamp + Read Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStarred"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:alpha="0.7"
                android:contentDescription="Starred"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvEdited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:alpha="0.6"
                android:text="@string/label_edited"
                android:textColor="#9EFFFFFF"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9EFFFFFF"
                android:textSize="10.5sp"
                tools:text="11:42 AM" />

            <ImageView
                android:id="@+id/ivMessageStatus"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_status_read" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
