<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="3dp">

    <!-- Outgoing Bubble Container -->
    <LinearLayout
        android:id="@+id/layoutBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:background="@drawable/bg_bubble_me"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">

        <!-- Forwarded Label -->
        <LinearLayout
            android:id="@+id/layoutForwarded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:alpha="0.6"
                android:src="@drawable/ic_forward"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:alpha="0.6"
                android:text="@string/label_forwarded"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Quoted Reply Container -->
        <include
            layout="@layout/layout_link_preview"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layoutQuotedReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_quoted_reply_me"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="3.5dp"
                android:layout_height="match_parent"
                android:background="@color/gochat_emerald_light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuotedSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_emerald_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Alex" />

                <TextView
                    android:id="@+id/tvQuotedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="12sp"
                    tools:text="Original message being replied to here..." />
            </LinearLayout>
        </LinearLayout>

        <!-- Media Image Preview -->
        <FrameLayout
            android:id="@+id/layoutImageContainer"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Attached Image"
                android:maxHeight="320dp"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />


            <FrameLayout
                android:id="@+id/pbImageLoadingContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_progress_circle"
                android:visibility="gone"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/pbImageLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="visible" />
            </FrameLayout>
        </FrameLayout>

        <!-- Voice Note Playback Row -->
        <LinearLayout
            android:id="@+id/layoutVoiceNote"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btnPlayPauseVoice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_pulse"
                android:contentDescription="Play/Pause"
                android:padding="8dp"
                android:src="@drawable/ic_play" />

            <com.example.gochat.ui.custom.WaveformView
                android:id="@+id/waveformVoice"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="11sp"
                    tools:text="0:14" />

                <TextView
                    android:id="@+id/btnVoiceSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_speed_pill"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="1.0x"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Product Card Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutProductCard"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#20FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#30FFFFFF"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProductCardImage"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                    android:contentDescription="Product Image"
                    tools:src="@drawable/ic_gallery" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvProductCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Product Name" />

                    <TextView
                        android:id="@+id/tvProductCardPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gochat_emerald_light"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        tools:text="$0.00" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnViewProductCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="#30FFFFFF"
                            android:gravity="center"
                            android:paddingVertical="5dp"
                            android:text="View Details"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnBuyNowProductCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="@color/whatsapp_teal_light"
                            android:gravity="center"
                            android:paddingVertical="5dp"
                            android:text="⚡ Buy Now"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Catalog Grid Card Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutCatalogCard"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#20FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#30FFFFFF"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Header: Store Icon, Catalog Title, Items Count Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_cart"
                        app:tint="@color/gochat_emerald_light"
                        android:contentDescription="Catalog" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCatalogCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Official Store Catalog" />

                        <TextView
                            android:id="@+id/tvCatalogCardSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/gochat_text_secondary"
                            android:textSize="10sp"
                            tools:text="Browse collection · 6 products" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCatalogCardCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_speed_pill"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="6 ITEMS" />
                </LinearLayout>

                <!-- 3 Preview Thumbnails -->
                <LinearLayout
                    android:id="@+id/layoutCatalogThumbs"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivCatalogThumb1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#15FFFFFF"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivCatalogThumb2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="#15FFFFFF"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                    <FrameLayout
                        android:id="@+id/containerCatalogThumb3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivCatalogThumb3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#15FFFFFF"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                        <TextView
                            android:id="@+id/tvCatalogMoreOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#99000000"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="+5" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Footer: View All Action -->
                <TextView
                    android:id="@+id/btnViewCatalogStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#30FFFFFF"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:text="🛍️ View Catalog"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Order Confirmation Card Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutOrderCard"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#20FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#30FFFFFF"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Header: Icon, Order Number, Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_orders"
                        app:tint="@color/gochat_emerald_light"
                        android:contentDescription="Order" />

                    <TextView
                        android:id="@+id/tvOrderCardNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="#ORD-849201" />

                    <TextView
                        android:id="@+id/tvOrderCardStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/whatsapp_teal_light"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="PAID" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOrderCardStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Apple Official Store" />

                <TextView
                    android:id="@+id/tvOrderCardSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gochat_text_muted"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="iPhone 15 Pro (x1)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total:"
                        android:textColor="@color/gochat_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvOrderCardTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gochat_emerald_light"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="$1,199.00" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnViewOrderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#30FFFFFF"
                    android:gravity="center"
                    android:paddingVertical="5dp"
                    android:text="Track / View Order →"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment Request / Invoice Card Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutPaymentCard"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#20FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#35FFFFFF"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_payment_card"
                        app:tint="@color/gochat_emerald_light" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Payment Request"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPaymentStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="#402980B9"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="PENDING" />
                </LinearLayout>

                <!-- Item Name & Note -->
                <TextView
                    android:id="@+id/tvPaymentItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Nike Air Max 90" />

                <TextView
                    android:id="@+id/tvPaymentNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/gochat_text_secondary"
                    android:textSize="11sp"
                    tools:text="Express shipping included" />

                <!-- Amount Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Amount:"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPaymentAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gochat_emerald_light"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="$120.00" />
                </LinearLayout>

                <!-- Escrow Tag -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/gochat_emerald_light" />

                    <TextView
                        android:id="@+id/tvPaymentEscrowNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Secured by GoChat Escrow"
                        android:textColor="@color/gochat_emerald_light"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Action Button -->
                <TextView
                    android:id="@+id/btnPaymentAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/gochat_emerald_light"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:text="💳 Pay Now"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Message Text -->

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/gochat_text_primary"
            android:textSize="14.5sp"
            tools:text="Hey there! This is a test message in GoChat." />

        <!-- Inline Translation Container -->
        <LinearLayout
            android:id="@+id/layoutTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_translation_container"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_translate"
                    app:tint="@color/gochat_emerald_light" />

                <TextView
                    android:id="@+id/tvTranslationHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textColor="@color/gochat_emerald_light"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Translated (Spanish → English)" />

                <ImageView
                    android:id="@+id/btnCloseTranslation"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Close translation"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/gochat_text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTranslatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="This is the translated message text." />
        </LinearLayout>

        <!-- Reactions Container -->
        <LinearLayout
            android:id="@+id/layoutReactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_reactions"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="👍 2 ❤️ 1" />
        </LinearLayout>

        <!-- Footer: Timestamp + Read Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Disappearing Timer Countdown Badge -->
            <LinearLayout
                android:id="@+id/layoutDisappearingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivDisappearingClock"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:alpha="0.85"
                    android:contentDescription="Disappearing timer"
                    android:src="@drawable/ic_timer"
                    app:tint="#B3FFFFFF" />

                <TextView
                    android:id="@+id/tvDisappearingCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2.5dp"
                    android:alpha="0.9"
                    android:textColor="#B3FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    tools:text="23h" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivStarred"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:alpha="0.7"
                android:contentDescription="Starred"
                android:src="@drawable/ic_star"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvEdited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:alpha="0.6"
                android:text="@string/label_edited"
                android:textColor="#9EFFFFFF"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9EFFFFFF"
                android:textSize="10.5sp"
                tools:text="11:42 AM" />

            <ImageView
                android:id="@+id/ivMessageStatus"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_status_read" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
