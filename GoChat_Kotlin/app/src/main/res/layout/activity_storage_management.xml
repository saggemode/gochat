<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whatsapp_bg_dark"
    android:orientation="vertical">

    <!-- Action Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarStorage"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/whatsapp_toolbar_dark"
        app:contentInsetStart="4dp"
        app:contentInsetEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBackStorage"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_back"
                app:tint="@color/gochat_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Manage Storage"
                android:textColor="@color/gochat_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Storage Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/whatsapp_surface_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvUsedStorageHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gochat_emerald_light"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="148.5 MB" />

                    <TextView
                        android:id="@+id/tvFreeStorageHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/gochat_text_secondary"
                        android:textSize="13sp"
                        tools:text="Used by GoChat • 24.8 GB free on device" />

                    <!-- Storage Bar -->
                    <ProgressBar
                        android:id="@+id/pbStorageUsage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:progress="25"
                        android:progressTint="@color/gochat_emerald_light" />

                    <!-- Legend -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_circle_pulse"
                                android:backgroundTint="@color/gochat_emerald_light" />

                            <TextView
                                android:id="@+id/tvMediaLegend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textColor="@color/gochat_text_secondary"
                                android:textSize="12sp"
                                tools:text="GoChat Media (148 MB)" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_circle_pulse"
                                android:backgroundTint="@color/gochat_text_muted" />

                            <TextView
                                android:id="@+id/tvAppsLegend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textColor="@color/gochat_text_secondary"
                                android:textSize="12sp"
                                android:text="Apps &amp; System" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1-Tap Quick Cleanup Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickClean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/whatsapp_surface_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_photo_add_slot"
                        android:padding="8dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/gochat_emerald_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1-Tap Cache Cleanup"
                            android:textColor="@color/gochat_text_primary"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvQuickCleanSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Clear temporary image and voice playback cache"
                            android:textColor="@color/gochat_text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickClean"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Clean"
                        android:textColor="@color/gochat_emerald_light"
                        app:backgroundTint="#2600A884" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chats Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="CHATS"
                android:textColor="@color/gochat_text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Progress Indicator while calculating -->
            <ProgressBar
                android:id="@+id/pbCalculatingStorage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="24dp"
                android:indeterminateTint="@color/gochat_emerald_light" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvEmptyChatsStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="No media found in any chat"
                android:textColor="@color/gochat_text_secondary"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Chats Recycler View -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStorageChats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
