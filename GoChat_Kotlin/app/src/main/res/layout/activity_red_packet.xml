<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B71C1C">

    <ImageButton
        android:id="@+id/btnCloseRedPacket"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_cancel"
        android:src="@drawable/ic_back"
        app:tint="#FFECB3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧧"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/tvRedPacketSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFECB3"
            android:textSize="15sp"
            android:text="A red packet for you" />

        <TextView
            android:id="@+id/tvRedPacketGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FFF8E1"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Best wishes!"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- Shown after claiming -->
        <TextView
            android:id="@+id/tvRedPacketAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#FFD54F"
            android:textSize="40sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="₦250.00"
            tools:visibility="visible"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/tvRedPacketRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFCDD2"
            android:textSize="13sp"
            tools:text="2 of 5 left"
            xmlns:tools="http://schemas.android.com/tools" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenRedPacket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:text="Open"
            android:textColor="#B71C1C"
            android:textSize="16sp"
            app:backgroundTint="#FFD54F"
            app:cornerRadius="28dp" />

        <ProgressBar
            android:id="@+id/progressRedPacket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
