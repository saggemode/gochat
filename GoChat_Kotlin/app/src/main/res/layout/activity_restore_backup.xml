<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gochat_bg_dark"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarRestore"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gochat_surface_dark"
        app:title="Restore Chat History"
        app:titleTextColor="@color/gochat_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Hero Illustration -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_pulse">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cloud_backup"
                    app:tint="@color/gochat_accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvRestoreHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Restore your chats &amp; media"
                android:textColor="@color/gochat_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRestoreSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="Restore your chat history and media from your end-to-end encrypted backup."
                android:textColor="@color/gochat_text_secondary"
                android:textSize="14sp" />

            <!-- Backup Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBackupInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/gochat_card_dark"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/gochat_border_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivBackupSourceIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_cloud_backup"
                            app:tint="@color/gochat_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBackupFoundTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Backup Found"
                                android:textColor="@color/gochat_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBackupSourceDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gochat_text_secondary"
                                android:textSize="13sp"
                                tools:text="Google Drive · user@gmail.com" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbScanningBackup"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminateTint="@color/gochat_accent"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerBackupInfo"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/gochat_border_dark" />

                    <LinearLayout
                        android:id="@+id/layoutBackupStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DATE"
                                android:textColor="@color/gochat_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvBackupDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/gochat_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Oct 19, 2026" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SIZE"
                                android:textColor="@color/gochat_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvBackupSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/gochat_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="14.8 MB" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHATS"
                                android:textColor="@color/gochat_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvBackupChatsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/gochat_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="14 chats" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Decryption Password Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRestorePassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Enter backup password"
                app:boxBackgroundColor="@color/gochat_card_dark"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/gochat_accent"
                app:hintTextColor="@color/gochat_accent"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/gochat_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRestorePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPasswordDisclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🔒 Backups are end-to-end encrypted. You must enter the exact password you used during backup."
                android:textColor="@color/gochat_text_secondary"
                android:textSize="12sp" />

            <!-- Restore Live Progress Section -->
            <LinearLayout
                android:id="@+id/layoutRestoreProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressRestore"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:indeterminate="false"
                    app:indicatorColor="@color/gochat_accent"
                    app:trackColor="@color/gochat_border_dark"
                    app:trackCornerRadius="4dp" />

                <TextView
                    android:id="@+id/tvRestoreStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Decrypting messages..."
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gochat_surface_dark"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/gochat_accent"
            android:text="Restore Chats"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipRestore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="Skip Restore"
            android:textColor="@color/gochat_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
