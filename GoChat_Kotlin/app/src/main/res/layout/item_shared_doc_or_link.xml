<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/ivDocOrLinkIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_photo_add_slot"
        android:padding="8dp"
        android:src="@drawable/ic_link"
        app:tint="@color/gochat_emerald_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDocOrLinkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gochat_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="https://github.com/golang/go" />

        <TextView
            android:id="@+id/tvDocOrLinkSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/gochat_text_secondary"
            android:textSize="12.5sp"
            tools:text="Yesterday • Tap to open link" />
    </LinearLayout>

</LinearLayout>
