<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/gochat_border_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Store Profile"
            android:textColor="@color/gochat_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Update your store branding, contact and marketplace info"
            android:textColor="@color/gochat_text_muted"
            android:textSize="13sp" />

        <!-- Store Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Store / Business Name *"
            android:textColorHint="@color/gochat_text_muted"
            app:boxStrokeColor="@color/whatsapp_teal_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditStoreName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gochat_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category and Phone Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Category"
                android:textColorHint="@color/gochat_text_muted"
                app:boxStrokeColor="@color/whatsapp_teal_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditStoreCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gochat_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Phone"
                android:textColorHint="@color/gochat_text_muted"
                app:boxStrokeColor="@color/whatsapp_teal_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditStorePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/gochat_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Location / Address -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Store Location / Address *"
            android:textColorHint="@color/gochat_text_muted"
            app:boxStrokeColor="@color/whatsapp_teal_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditStoreLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gochat_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Store Logo Picker (From Phone) -->
        <LinearLayout
            android:id="@+id/layoutSelectEditStoreLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_store_logo_picker"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivEditStoreLogoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_photo_add_slot"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_camera_status"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                <ImageButton
                    android:id="@+id/btnRemoveEditStoreLogo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_circle_close_badge"
                    android:contentDescription="Remove logo"
                    android:padding="3dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Store Logo (from phone)"
                    android:textColor="@color/gochat_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEditStoreLogoSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap to change logo from phone"
                    android:textColor="@color/whatsapp_teal_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="About Your Store / Bio"
            android:textColorHint="@color/gochat_text_muted"
            app:boxStrokeColor="@color/whatsapp_teal_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditStoreDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:lines="3"
                android:textColor="@color/gochat_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveStoreChanges"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/whatsapp_teal_light"
            android:text="Save Store Changes"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
