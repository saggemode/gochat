<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GoChat" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/gochat_accent</item>
        <item name="colorPrimaryDark">@color/gochat_emerald_dark</item>
        <item name="colorSecondary">@color/gochat_emerald_light</item>
        <item name="colorSurface">@color/gochat_surface_dark</item>
        <item name="colorSurfaceContainerHighest">@color/gochat_card_dark</item>
        <item name="colorError">@color/gochat_error</item>

        <!-- On Colors -->
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnSurface">@color/gochat_text_primary</item>

        <!-- System Window Bars -->
        <item name="android:windowBackground">@color/gochat_bg_dark</item>
        <item name="android:statusBarColor">@color/gochat_bg_dark</item>
        <item name="android:navigationBarColor">@color/gochat_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.GoChat" parent="Base.Theme.GoChat" />
</resources>