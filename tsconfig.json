{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["website/*", "frontend/*"]
    }
  },
  "references": [
    { "path": "./website" },
    { "path": "./frontend" }
  ],
  "exclude": ["node_modules", "flutter", "gen"]
}
