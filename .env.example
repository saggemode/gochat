# ──────────────────────────────────────────────────────────────
# GoChat — Environment Variables
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL & PgBouncer ───────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=gochat

AUTH_PORT=4001
AUTH_DB_DSN=postgres://postgres:123@pgbouncer:6432/auth-gochat-db?sslmode=disable

CHAT_PORT=4002
CHAT_DB_DSN=postgres://postgres:123@pgbouncer:6432/chat-gochat-db?sslmode=disable

AUTHZ_PORT=4005
AUTHZ_DB_DSN=postgres://postgres:123@pgbouncer:6432/authz-gochat-db?sslmode=disable

GROUP_PORT=4006
GROUP_DB_DSN=postgres://postgres:123@pgbouncer:6432/group-gochat-db?sslmode=disable

STORY_PORT=4007
STORY_DB_DSN=postgres://postgres:123@pgbouncer:6432/story-gochat-db?sslmode=disable

CALL_PORT=4008
CALL_DB_DSN=postgres://postgres:123@pgbouncer:6432/call-gochat-db?sslmode=disable

CHANNEL_PORT=4009
CHANNEL_DB_DSN=postgres://postgres:123@pgbouncer:6432/channel-gochat-db?sslmode=disable

AI_PORT=4010
AI_DB_DSN=postgres://postgres:123@pgbouncer:6432/ai-gochat-db?sslmode=disable

PAYMENT_PORT=4011
PAYMENT_DB_DSN=postgres://postgres:123@pgbouncer:6432/payment-gochat-db?sslmode=disable

SOCIAL_PORT=4012
SOCIAL_DB_DSN=postgres://postgres:123@pgbouncer:6432/social-gochat-db?sslmode=disable

MINIAPP_PORT=4013
MINIAPP_DB_DSN=postgres://postgres:123@pgbouncer:6432/miniapp-gochat-db?sslmode=disable

BUSINESS_PORT=4004
BUSINESS_DB_DSN=postgres://postgres:123@pgbouncer:6432/business-gochat-db?sslmode=disable

# ── Redis ────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# ── MinIO (S3-compatible storage) ────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=gochat-media
MINIO_USE_SSL=false

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ── Gateway ──────────────────────────────────────────────────
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:5173

# ── gRPC Service Addresses (for local development) ──────────
# Each service listens on its own GRPC_PORT; the gateway dials
# these addresses to forward HTTP requests to gRPC backends.
AUTH_GRPC_ADDR=localhost:50051
CHAT_GRPC_ADDR=localhost:50052
MEDIA_GRPC_ADDR=localhost:50053
AUTHZ_GRPC_ADDR=localhost:50054
GROUP_GRPC_ADDR=localhost:50055
STORY_GRPC_ADDR=localhost:50056
CALL_GRPC_ADDR=localhost:50057
CHANNEL_GRPC_ADDR=localhost:50058
AI_GRPC_ADDR=localhost:50059
PAYMENT_GRPC_ADDR=localhost:50060
SOCIAL_GRPC_ADDR=localhost:50061
MINIAPP_GRPC_ADDR=localhost:50062
BUSINESS_GRPC_ADDR=localhost:50063
