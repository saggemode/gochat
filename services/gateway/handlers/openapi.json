  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provide your JWT Access Token: Bearer <token>"
      },
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gochat_access_token",
        "description": "HttpOnly session cookie"
      },
      "CSRFToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "CSRF Token for mutating requests"
      }
    }
  }
}
